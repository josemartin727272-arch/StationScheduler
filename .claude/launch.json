{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Streamlit App",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8501"],
      "port": 8501
    },
    {
      "name": "PWA (docs)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "docs"],
      "port": 8765
    }
  ]
}
